[Desktop Entry]
Version=1.0
Type=Application
Name=AetherOS
GenericName=Application Menu
Comment=Open AetherOS Application Launcher
Exec=sh -c "which rofi >/dev/null 2>&1 && rofi -show drun || (which jgmenu >/dev/null 2>&1 && jgmenu_run) || gnome-terminal"
Icon=/usr/share/pixmaps/aether-icon.png
Terminal=false
Categories=System;
StartupNotify=false
