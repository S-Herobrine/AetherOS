[Desktop Entry]
Version=1.0
Type=Application
Name=AetherOS
GenericName=Application Menu
Comment=Open AetherOS Centered Liquid Glass Start Menu
Exec=sh -c "which rofi >/dev/null 2>&1 && rofi -show drun -theme /etc/xdg/rofi/aetheros-start.rasi -show-icons || gnome-terminal"
Icon=/usr/share/pixmaps/aether-icon.png
Terminal=false
Categories=System;
StartupNotify=false
