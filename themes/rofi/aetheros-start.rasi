/* ============================================================================
 * AetherOS Centered Liquid Glass Start Menu (Rofi Theme)
 * Clean Windows 11 / NavaOS Inspired Centered App Launcher
 * ============================================================================ */

* {
    bg-glass:       rgba(14, 12, 30, 0.88);
    bg-item:        rgba(255, 255, 255, 0.05);
    bg-selected:    rgba(79, 134, 247, 0.35);
    border-glass:   rgba(255, 255, 255, 0.16);
    border-accent:  rgba(79, 134, 247, 0.85);
    fg-main:        #FFFFFF;
    fg-muted:       #A5A1B8;

    background-color: transparent;
    text-color:       @fg-main;
    font:             "Inter 10";
}

window {
    transparency:     "real";
    background-color: @bg-glass;
    border:           1px solid;
    border-color:     @border-glass;
    border-radius:    22px;
    width:            640px;
    padding:          22px;
    location:         center;
    anchor:           center;
}

mainbox {
    spacing:          16px;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: rgba(255, 255, 255, 0.07);
    border:           1px solid;
    border-color:     @border-glass;
    border-radius:    999px;
    padding:          10px 18px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       #4F86F7;
    font:             "Inter Bold 11";
}

entry {
    placeholder:       "Search AetherOS apps, Android APKs, Windows tools...";
    placeholder-color: @fg-muted;
}

listview {
    columns:          4;
    lines:            3;
    spacing:          12px;
    fixed-height:     true;
    scrollbar:        false;
}

element {
    orientation:      vertical;
    background-color: @bg-item;
    border:           1px solid;
    border-color:     transparent;
    border-radius:    16px;
    padding:          14px 8px;
    spacing:          8px;
}

element selected {
    background-color: @bg-selected;
    border-color:     @border-accent;
}

element-icon {
    size:             40px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    text-color:       @fg-main;
}
