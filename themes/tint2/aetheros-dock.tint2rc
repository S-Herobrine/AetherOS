# ==============================================================================
# AetherOS Floating Liquid Glass Pill Dock (FlowOS / Nava OS Architecture)
# Centered Floating Capsule with Claude's AetherOS Logo, Tasklist, Systray & Clock
# ==============================================================================

# Background 1: Main Floating Glass Capsule
rounded = 20
border_width = 1
border_sides = TBLR
background_color = #0E0C1E 190
border_color = #FFFFFF 35
background_color_hover = #0E0C1E 210
border_color_hover = #4F86F7 90
background_color_pressed = #0E0C1E 230
border_color_pressed = #4F86F7 120

# Background 2: Active / Running Task Indicator
rounded = 12
border_width = 1
border_sides = TBLR
background_color = #4F86F7 40
border_color = #4F86F7 100
background_color_hover = #4F86F7 60
border_color_hover = #4F86F7 140
background_color_pressed = #7B73F0 80
border_color_pressed = #7B73F0 160

# Background 3: Start Button & Icon Pill
rounded = 14
border_width = 0
background_color = #FFFFFF 15
border_color = #FFFFFF 0
background_color_hover = #4F86F7 50
border_color_hover = #4F86F7 100

# Panel Configuration: Centered Floating Dock
panel_items = LTSC
panel_size = 72% 52
panel_margin = 0 14
panel_padding = 10 4 8
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
autohide = 0
strut_policy = follow_size

# Taskbar (Running applications)
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 6 0 8
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_name_padding = 0 0
taskbar_name_background_id = 0
taskbar_name_active_background_id = 0
taskbar_distribute_size = 0
taskbar_sort_order = none

# Task (Individual app button)
task_icon = 1
task_text = 0
task_centered = 1
task_maximum_size = 46 44
task_padding = 4 4 4
task_font = Inter 10
task_tooltip = 1
task_thumbnail = 1
task_thumbnail_size = 210
task_font_color = #FFFFFF 80
task_icon_asb = 95 0 0
task_background_id = 0
task_active_background_id = 2
task_urgent_background_id = 2
task_iconified_background_id = 0

# Launcher (AetherOS Logo / Start Menu Button)
launcher_padding = 6 0 10
launcher_background_id = 3
launcher_icon_size = 32
launcher_icon_theme = Papirus-Dark
launcher_item_app = /usr/share/applications/aether-menu.desktop
launcher_item_app = /usr/share/applications/install-aetheros.desktop
launcher_item_app = /usr/share/applications/firefox.desktop
launcher_item_app = /usr/share/applications/satasos-files.desktop
launcher_item_app = /usr/share/applications/satasos-settings.desktop
launcher_item_app = /usr/share/applications/gnome-terminal.desktop

# System Tray
systray_padding = 6 0 8
systray_background_id = 0
systray_sort = right2left
systray_icon_size = 20
systray_icon_asb = 100 0 0

# Clock (Clean Modern Minimal)
time1_format = %H:%M
time1_font = Inter Bold 12
time2_format = %a, %d %b
time2_font = Inter 8
clock_font_color = #FFFFFF 100
clock_padding = 10 0
clock_background_id = 0
clock_tooltip = %A, %B %d, %Y
clock_lclick_command = gsimplecal || true

# Tooltip
tooltip_show_after = 300
tooltip_hide_after = 0
tooltip_padding = 8 6
tooltip_background_id = 1
tooltip_font = Inter 9
tooltip_font_color = #FFFFFF 100
