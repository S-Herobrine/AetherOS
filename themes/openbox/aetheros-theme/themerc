# AetherOS Modern Liquid Dark Openbox Theme
border.width: 1
padding.width: 6
padding.height: 5
window.handle.width: 0

window.active.border.color: #4F86F7
window.inactive.border.color: #1E1B2E

window.active.title.bg: flat solid
window.active.title.bg.color: #12132D
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0E0C1E

window.active.label.text.color: #FFFFFF
window.inactive.label.text.color: #8E8A9F
window.label.text.justify: center

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #12132D
window.active.button.unpressed.image.color: #FFFFFF

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #4F86F7
window.active.button.hover.image.color: #FFFFFF

window.active.button.close.hover.bg: flat solid
window.active.button.close.hover.bg.color: #F43F5E
window.active.button.close.hover.image.color: #FFFFFF

menu.border.width: 1
menu.border.color: rgba(255,255,255,0.15)
menu.title.bg: flat solid
menu.title.bg.color: #12132D
menu.title.text.color: #FFFFFF
menu.title.text.justify: center
menu.items.bg: flat solid
menu.items.bg.color: #0E0C1E
menu.items.text.color: #E8E0F0
menu.items.active.bg: flat solid
menu.items.active.bg.color: #4F86F7
menu.items.active.text.color: #FFFFFF
